# Secrets
proxy.token
*.token
proxy.env

# Chrome user data
chrome-profile/

# Debug dumps
debug/

# Built binaries
search-service
search-proxy
search-relay
*.exe

# Search / download cache (data dir at repo root, not internal/cache)
/cache/

# Local API keys + engine priority (mode 0600). Never commit.
search-config.json
**/search-config.json

# Agent papers runtime data (keep scripts; ignore heavy artifacts)
agent-papers/pdfs/
agent-papers/cache/
agent-papers/__pycache__/
agent-papers/*.db
agent-papers/manifest.json
agent-papers/index.md
agent-papers/sync_report.json
agent-papers/sync_latest.md
agent-papers/expand_*.md
agent-papers/expand_*.log
agent-papers/email_digest_body.txt
agent-papers/test_digest_email.txt
agent-papers/*_digest_*.txt
!agent-papers/build_email_digest.py
agent-papers/translate-config.json
agent-papers/translate_status.json
agent-papers/translate-work/
**/translate-config.json

# Cached Chinese paper abstracts (runtime LLM output)
agent-papers/abstracts_zh.json
**/abstracts_zh.json

# Papers visit counter + ops pause (runtime)
agent-papers/visit-stats.json
**/visit-stats.json
agent-papers/translate.pause
**/translate.pause

# Paper reviews (LLM 解读 + ratings; runtime, never commit)
agent-papers/reviews/
**/agent-papers/reviews/

# Local rebuild leftovers
search-proxy-linux
search-service.prev
search-service.restart.log
*.restart.log
